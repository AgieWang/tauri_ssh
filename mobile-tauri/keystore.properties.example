# Android 签名密钥配置示例
#
# 使用方法：
#   1. 复制为 keystore.properties（已在 .gitignore 中）
#   2. 填入实际路径与密码
#   3. CI 环境通过 secrets 注入这四个字段 + keystore 二进制
#
# ⚠️ 永远不要 commit keystore.properties 实文件！

storeFile=/abs/path/to/release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
