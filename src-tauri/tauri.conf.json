{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri SSH",
  "version": "0.1.0",
  "identifier": "com.agilefr.tauri-ssh",
  "build": {
    "beforeDevCommand": "pnpm dev:clean",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri SSH",
        "width": 1330,
        "height": 830,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://gitee.com/AgieWang/tauri_ssh-release/raw/master/update.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMDJFMzlBMjMzMzg0RUYKUldUdmhETWptdU1DTUVWcHFEWFNyWEJ2R2dGOWY2WVErc0NrajBzeTNldmxYZmtvQmhKZlhpTVQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}
